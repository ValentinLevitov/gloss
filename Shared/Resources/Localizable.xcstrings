            "state": "translated",
            "value": "Формы"
          }
        }
      }
    },
    "Examples": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примеры"
          }
        }
      }
    },
    "Note": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примечание"
          }
        }
      }
    },
