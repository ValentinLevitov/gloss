    "Tap Next to continue.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми «Далее», чтобы продолжить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Weiter“, um fortzufahren."
          }
        },
        "fr": {
