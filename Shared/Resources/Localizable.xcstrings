    "Allow microphone and speech recognition in Settings to dictate.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы диктовать, разреши микрофон и распознавание речи в Настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mikrofon und Spracherkennung in den Einstellungen, um zu diktieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le micro et la reconnaissance vocale dans Réglages pour dicter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el micrófono y el reconocimiento de voz en Ajustes para dictar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti microfono e riconoscimento vocale in Impostazioni per dettare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o microfone e o reconhecimento de fala nos Ajustes para ditar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб диктувати, дозвольте доступ до мікрофона й розпізнавання мовлення в Налаштуваннях."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dyktować, zezwól na dostęp do mikrofonu i rozpoznawanie mowy w Ustawieniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte için Ayarlar'da mikrofona ve konuşma tanımaya izin verin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するには、設定でマイクと音声認識を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 사용하려면 설정에서 마이크와 음성 인식을 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许使用麦克风和语音识别，以便听写。"
          }
        }
      }
    },
