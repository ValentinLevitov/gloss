          "stringUnit": {
            "state": "translated",
            "value": "Карточек пока нет"
          }
        }
      }
    },
    "Select a word in any translation and choose “Add to cards”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдели слово в любом переводе и выбери «В карточки»."
