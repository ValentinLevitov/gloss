    },
    "Paste a key; it is checked automatically. Next unlocks once a key is saved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставь ключ — он проверится сам. «Далее» станет активна, когда ключ сохранён."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Schlüssel ein; er wird automatisch geprüft. „Weiter“ wird aktiv, sobald ein Schlüssel gespeichert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une clé ; elle est vérifiée automatiquement. « Suivant » s’active dès qu’une clé est enregistrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una clave; se comprueba automáticamente. «Siguiente» se activa al guardar una clave."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla una chiave: viene verificata automaticamente. Avanti si attiva quando la chiave è salvata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole uma chave; ela é verificada automaticamente. Avançar é liberado assim que a chave for salva."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте ключ — він перевіряється автоматично. Кнопка «Далі» стане активною, коли ключ збережено."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej klucz — zostanie sprawdzony automatycznie. Przycisk Dalej odblokuje się po zapisaniu klucza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir anahtar yapıştırın; otomatik olarak denetlenir. Anahtar kaydedilince İleri etkinleşir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを貼り付けると自動で確認します。キーを保存すると「次へ」が使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 붙여넣으면 자동으로 확인됩니다. 키가 저장되면 다음으로 넘어갈 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴密钥后会自动校验。保存密钥后即可进行下一步。"
          }
        }
      }
    },
