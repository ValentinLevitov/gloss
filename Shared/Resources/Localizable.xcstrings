    "Translations from the app and the system menu will show up here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся переводы — и из приложения, и из системного меню."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzungen aus der App und dem Systemmenü erscheinen hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les traductions issues de l’app et du menu système apparaîtront ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecerán las traducciones de la app y del menú del sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traduzioni dall'app e dal menu di sistema compariranno qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As traduções do app e do menu do sistema aparecerão aqui."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являтимуться переклади із застосунку та системного меню."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenia z aplikacji i z menu systemowego pojawią się tutaj."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan ve sistem menüsünden yapılan çeviriler burada görünecek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリやシステムメニューからの翻訳がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 시스템 메뉴에서 번역한 내용이 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
