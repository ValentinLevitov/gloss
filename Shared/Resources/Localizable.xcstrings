    "Swipe right if you remembered it, left if not.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп вправо — помню, влево — забыл."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach rechts, wenn du es wusstest, sonst nach links."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers la droite si vous vous en souvenez, vers la gauche sinon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha si la recordaste, a la izquierda si no."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a destra se l'hai ricordata, a sinistra se no."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a direita se lembrou, para a esquerda se não."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп праворуч — якщо згадали, ліворуч — якщо ні."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w prawo, jeśli pamiętasz, w lewo, jeśli nie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırladıysanız sağa, hatırlamadıysanız sola kaydırın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えていたら右、覚えていなければ左にスワイプします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억났으면 오른쪽으로, 아니면 왼쪽으로 쓸어넘기세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住了就向右滑，没记住就向左滑。"
          }
        }
      }
    },
