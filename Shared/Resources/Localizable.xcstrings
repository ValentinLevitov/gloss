    "Keys are stored only in this device's Keychain. Requests go directly to the provider.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи хранятся только в Keychain этого устройства. Запросы идут напрямую провайдеру."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel werden nur im Schlüsselbund dieses Geräts gespeichert. Anfragen gehen direkt an den Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés sont stockées uniquement dans le trousseau de cet appareil. Les requêtes vont directement au fournisseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves se guardan solo en el llavero de este dispositivo. Las solicitudes van directamente al proveedor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi vengono salvate solo nel portachiavi di questo dispositivo. Le richieste vanno direttamente al provider."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves ficam apenas nas Chaves deste dispositivo. As solicitações vão direto para o provedor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі зберігаються лише в Keychain цього пристрою. Запити надсилаються безпосередньо до постачальника."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze są przechowywane tylko w pęku kluczy tego urządzenia. Zapytania trafiają bezpośrednio do dostawcy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar yalnızca bu aygıtın Anahtar Zinciri'nde saklanır. İstekler doğrudan sağlayıcıya gider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこのデバイスのキーチェーンにのみ保存されます。リクエストはプロバイダへ直接送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 기기의 키체인에만 저장됩니다. 요청은 제공업체로 직접 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥仅保存在此设备的钥匙串中。请求会直接发送给服务提供方。"
          }
        }
      }
    },
