    "The reply hit the token limit — the text is too long, split it up.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ обрезан по лимиту токенов — текст слишком длинный, разбей на части."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort hat das Token-Limit erreicht — der Text ist zu lang, teile ihn auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse a atteint la limite de tokens — le texte est trop long, divisez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta alcanzó el límite de tokens: el texto es demasiado largo, divídelo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta ha raggiunto il limite di token: il testo è troppo lungo, dividilo."
