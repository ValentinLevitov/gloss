    "Type a word or a text. Then select any fragment to discuss it — the thread keeps its context.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбей слово или текст. Потом можно выделить любой фрагмент и обсудить его — контекст нити сохраняется."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein Wort oder einen Text ein. Wähle dann ein Fragment aus, um es zu besprechen — der Verlauf behält den Kontext."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un mot ou un texte. Sélectionnez ensuite un fragment pour en discuter — la conversation garde son contexte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una palabra o un texto. Luego selecciona cualquier fragmento para comentarlo: la conversación mantiene el contexto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una parola o un testo. Poi seleziona un frammento per discuterne: la conversazione mantiene il contesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma palavra ou um texto. Depois selecione qualquer trecho para conversar sobre ele — a conversa mantém o contexto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть слово або текст. Потім виділіть будь-який фрагмент, щоб обговорити його — розмова зберігає контекст."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz słowo lub tekst. Następnie zaznacz dowolny fragment, aby go omówić — wątek zachowuje kontekst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kelime veya metin yazın. Ardından tartışmak için herhangi bir parçayı seçin — sohbet bağlamı korur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語や文章を入力します。断片を選択すればそれについて相談でき、会話は文脈を保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어나 텍스트를 입력하세요. 그런 다음 구절을 선택해 대화하세요 — 대화는 맥락을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入一个词或一段文本。然后选中任意片段进行讨论——对话会保留上下文。"
          }
        }
      }
    },
