    "Placeholders: %@ are filled from the language settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плейсхолдеры %@ подставляются из настроек языков."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzhalter: %@ werden aus den Spracheinstellungen gefüllt."
