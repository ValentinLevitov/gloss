      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть в изучаемые"
          }
        }
      }
    },
    "Mark as learned": {
      "localizations": {
        "ru": {
          "stringUnit": {
